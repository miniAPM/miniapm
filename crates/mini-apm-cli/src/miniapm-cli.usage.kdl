bin "miniapm-cli"
about "MiniAPM CLI"
subcommand_required #true
cmd "list-projects" help="List projects and their API keys"
cmd "regenerate-key" help="Regenerate a project's API key" {
    arg "<project>" help="Project slug"
}
cmd "reset-password" help="Reset a user's password" {
    arg "<username>" help="Username to reset password for"
    arg "<password>" help="New password"
}
cmd "list-users" help="List all users"
